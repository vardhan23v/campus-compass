generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth Models ────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ─────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  savedColleges SavedCollege[]
  reviews       Review[]
  accounts      Account[]
  sessions      Session[]
}

model College {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  longDescription String?
  image           String
  location        String
  city            String
  state           String
  rating          Float    @default(0)
  totalReviews    Int      @default(0)
  feesMin         Int
  feesMax         Int
  established     Int?
  type            String   @default("PRIVATE")
  accreditation   String?
  website         String?
  phone           String?
  email           String?
  ranking         Int?

  avgPackage     Float?
  highestPackage Float?
  placementRate  Float?
  topRecruiters  String?

  facilities String?

  isFeatured Boolean @default(false)
  isTrending Boolean @default(false)

  courses Course[]
  reviews Review[]
  savedBy SavedCollege[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id        String  @id @default(cuid())
  name      String
  duration  String
  fees      Int
  seats     Int?
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  collegeId String
}

model Review {
  id        String   @id @default(cuid())
  rating    Float
  title     String
  comment   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  collegeId String
  createdAt DateTime @default(now())
}

model SavedCollege {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  collegeId String
  createdAt DateTime @default(now())

  @@unique([userId, collegeId])
}
